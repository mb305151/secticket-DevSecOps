{
  "name": "secticket-frontend",
  "private": true,
  "version": "1.0.0",
  "description": "Tailwind CSS build for SecTicket Flask templates",
  "scripts": {
    "build:css": "tailwindcss -i ./app/static/styles.css -o ./app/static/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./app/static/styles.css -o ./app/static/tailwind.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  }
}
